<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layout_lock_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:paddingStart="24dp"
    android:paddingEnd="24dp">

    <!-- Top Spacer / Center content vertically -->
    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.8" />

    <!-- Security Icon -->
    <FrameLayout
        android:id="@+id/badge_lock_icon"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:background="@drawable/bg_icon_badge_blue">

        <ImageView
            android:id="@+id/iv_lock_status_icon"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_lock"
            app:tint="@color/colorPrimary"
            android:contentDescription="Security Lock" />
    </FrameLayout>

    <!-- Title -->
    <TextView
        android:id="@+id/tv_lock_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Unlock Hkode"
        android:textColor="@color/text_primary"
        android:textSize="22sp"
        android:textStyle="bold" />

    <!-- Subtitle -->
    <TextView
        android:id="@+id/tv_lock_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Enter your 4-digit passcode"
        android:textColor="@color/text_secondary"
        android:textSize="14sp" />

    <!-- Error Text -->
    <TextView
        android:id="@+id/tv_lock_error"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Incorrect passcode"
        android:textColor="@color/color_error"
        android:textSize="13sp"
        android:textStyle="bold"
        android:visibility="invisible" />

    <!-- 4-Digit Visual PIN Slots -->
    <LinearLayout
        android:id="@+id/layout_pin_slots"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:orientation="horizontal"
        android:gravity="center">

        <!-- Slot 1 -->
        <FrameLayout
            android:id="@+id/slot_pin_1"
            android:layout_width="52dp"
            android:layout_height="56dp"
            android:layout_margin="6dp"
            android:background="@drawable/bg_pin_box">

            <View
                android:id="@+id/dot_pin_1"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_pin_dot"
                android:visibility="gone" />
        </FrameLayout>

        <!-- Slot 2 -->
        <FrameLayout
            android:id="@+id/slot_pin_2"
            android:layout_width="52dp"
            android:layout_height="56dp"
            android:layout_margin="6dp"
            android:background="@drawable/bg_pin_box">

            <View
                android:id="@+id/dot_pin_2"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_pin_dot"
                android:visibility="gone" />
        </FrameLayout>

        <!-- Slot 3 -->
        <FrameLayout
            android:id="@+id/slot_pin_3"
            android:layout_width="52dp"
            android:layout_height="56dp"
            android:layout_margin="6dp"
            android:background="@drawable/bg_pin_box">

            <View
                android:id="@+id/dot_pin_3"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_pin_dot"
                android:visibility="gone" />
        </FrameLayout>

        <!-- Slot 4 -->
        <FrameLayout
            android:id="@+id/slot_pin_4"
            android:layout_width="52dp"
            android:layout_height="56dp"
            android:layout_margin="6dp"
            android:background="@drawable/bg_pin_box">

            <View
                android:id="@+id/dot_pin_4"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_pin_dot"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>

    <!-- Mid Spacer -->
    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Sleek Numeric Keypad -->
    <TableLayout
        android:id="@+id/table_keypad"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:stretchColumns="*">

        <!-- Row 1: 1, 2, 3 -->
        <TableRow
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:layout_marginBottom="12dp">

            <TextView
                android:id="@+id/btn_key_1"
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:layout_margin="6dp"
                android:background="@drawable/bg_keypad_button"
                android:gravity="center"
                android:text="1"
                android:textColor="@color/text_primary"
                android:textSize="24sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/btn_key_2"
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:layout_margin="6dp"
                android:background="@drawable/bg_keypad_button"
                android:gravity="center"
                android:text="2"
                android:textColor="@color/text_primary"
                android:textSize="24sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/btn_key_3"
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:layout_margin="6dp"
                android:background="@drawable/bg_keypad_button"
                android:gravity="center"
                android:text="3"
                android:textColor="@color/text_primary"
                android:textSize="24sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true" />
        </TableRow>

        <!-- Row 2: 4, 5, 6 -->
        <TableRow
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:layout_marginBottom="12dp">

            <TextView
                android:id="@+id/btn_key_4"
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:layout_margin="6dp"
                android:background="@drawable/bg_keypad_button"
                android:gravity="center"
                android:text="4"
                android:textColor="@color/text_primary"
                android:textSize="24sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/btn_key_5"
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:layout_margin="6dp"
                android:background="@drawable/bg_keypad_button"
                android:gravity="center"
                android:text="5"
                android:textColor="@color/text_primary"
                android:textSize="24sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/btn_key_6"
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:layout_margin="6dp"
                android:background="@drawable/bg_keypad_button"
                android:gravity="center"
                android:text="6"
                android:textColor="@color/text_primary"
                android:textSize="24sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true" />
        </TableRow>

        <!-- Row 3: 7, 8, 9 -->
        <TableRow
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:layout_marginBottom="12dp">

            <TextView
                android:id="@+id/btn_key_7"
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:layout_margin="6dp"
                android:background="@drawable/bg_keypad_button"
                android:gravity="center"
                android:text="7"
                android:textColor="@color/text_primary"
                android:textSize="24sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/btn_key_8"
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:layout_margin="6dp"
                android:background="@drawable/bg_keypad_button"
                android:gravity="center"
                android:text="8"
                android:textColor="@color/text_primary"
                android:textSize="24sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/btn_key_9"
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:layout_margin="6dp"
                android:background="@drawable/bg_keypad_button"
                android:gravity="center"
                android:text="9"
                android:textColor="@color/text_primary"
                android:textSize="24sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true" />
        </TableRow>

        <!-- Row 4: Biometric, 0, Backspace -->
        <TableRow
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center">

            <!-- Biometric button -->
            <FrameLayout
                android:id="@+id/btn_key_biometric"
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:layout_margin="6dp"
                android:background="@drawable/bg_keypad_button"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/iv_key_biometric_icon"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_fingerprint"
                    app:tint="@color/colorPrimary"
                    android:contentDescription="Biometric Authentication" />
            </FrameLayout>

            <!-- 0 -->
            <TextView
                android:id="@+id/btn_key_0"
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:layout_margin="6dp"
                android:background="@drawable/bg_keypad_button"
                android:gravity="center"
                android:text="0"
                android:textColor="@color/text_primary"
                android:textSize="24sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true" />

            <!-- Backspace button -->
            <FrameLayout
                android:id="@+id/btn_key_backspace"
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:layout_margin="6dp"
                android:background="@drawable/bg_keypad_button"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_backspace"
                    app:tint="@color/text_primary"
                    android:contentDescription="Backspace" />
            </FrameLayout>
        </TableRow>
    </TableLayout>

    <!-- Forgotten Passcode Option -->
    <TextView
        android:id="@+id/btn_forgot_passcode"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        android:text="Forgot Passcode?"
        android:textColor="@color/colorPrimary"
        android:textSize="14sp"
        android:textStyle="bold"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:clickable="true"
        android:focusable="true"
        android:background="?attr/selectableItemBackgroundBorderless" />
</LinearLayout>

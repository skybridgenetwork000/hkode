<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	android:id="@+id/layout_onboarding_root"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:background="@color/app_background"
	android:orientation="vertical">

	<!-- Top Bar with Skip Action -->
	<LinearLayout
		android:id="@+id/header_onboarding"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:paddingStart="24dp"
		android:paddingEnd="20dp"
		android:paddingTop="20dp"
		android:paddingBottom="12dp"
		android:gravity="center_vertical"
		android:orientation="horizontal">

		<View
			android:layout_width="0dp"
			android:layout_height="1dp"
			android:layout_weight="1" />

		<com.google.android.material.button.MaterialButton
			android:id="@+id/btn_onboarding_skip"
			style="@style/Widget.MaterialComponents.Button.TextButton"
			android:layout_width="wrap_content"
			android:layout_height="36dp"
			android:minHeight="36dp"
			android:insetTop="0dp"
			android:insetBottom="0dp"
			app:elevation="0dp"
			android:stateListAnimator="@null"
			android:text="Skip"
			android:textColor="@color/text_secondary"
			android:textSize="13sp"
			android:textAllCaps="false" />
	</LinearLayout>

	<!-- Main Content Area with ViewFlipper -->
	<FrameLayout
		android:layout_width="match_parent"
		android:layout_height="0dp"
		android:layout_weight="1">

		<ViewFlipper
			android:id="@+id/flipper_onboarding"
			android:layout_width="match_parent"
			android:layout_height="match_parent">

			<!-- Step 1: Hkode Private message encryption -->
			<LinearLayout
				android:layout_width="match_parent"
				android:layout_height="match_parent"
				android:gravity="center"
				android:orientation="vertical"
				android:paddingStart="32dp"
				android:paddingEnd="32dp">

				<ImageView
					android:layout_width="96dp"
					android:layout_height="96dp"
					android:src="@drawable/logo_3"
					android:scaleType="fitCenter"
					android:contentDescription="Hkode logo" />

				<TextView
					android:id="@+id/tv_onboarding_title_1"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:layout_marginTop="32dp"
					android:text="Hkode"
					android:textColor="@color/text_primary"
					android:textSize="26sp"
					android:textStyle="bold"
					android:gravity="center" />

				<TextView
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:layout_marginTop="4dp"
					android:text="Private message encryption"
					android:textColor="@color/colorPrimary"
					android:textSize="15sp"
					android:textStyle="bold"
					android:gravity="center" />

				<TextView
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:layout_marginTop="12dp"
					android:text="Protect your messages before you share them."
					android:textColor="@color/text_secondary"
					android:textSize="14sp"
					android:gravity="center"
					android:lineSpacingExtra="3dp" />
			</LinearLayout>

			<!-- Step 2: Encrypt privately -->
			<LinearLayout
				android:layout_width="match_parent"
				android:layout_height="match_parent"
				android:gravity="center"
				android:orientation="vertical"
				android:paddingStart="32dp"
				android:paddingEnd="32dp">

				<FrameLayout
					android:layout_width="96dp"
					android:layout_height="96dp"
					android:background="@drawable/bg_icon_badge_blue">

					<ImageView
						android:layout_width="48dp"
						android:layout_height="48dp"
						android:layout_gravity="center"
						android:src="@drawable/ic_encrypt_card"
						android:contentDescription="Encrypt icon" />
				</FrameLayout>

				<TextView
					android:id="@+id/tv_onboarding_title_2"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:layout_marginTop="32dp"
					android:text="Encrypt privately"
					android:textColor="@color/text_primary"
					android:textSize="24sp"
					android:textStyle="bold"
					android:gravity="center" />

				<TextView
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:layout_marginTop="12dp"
					android:text="Turn any normal text into protected cipher text that can be safely shared with anyone."
					android:textColor="@color/text_secondary"
					android:textSize="14sp"
					android:gravity="center"
					android:lineSpacingExtra="3dp" />
			</LinearLayout>

			<!-- Step 3: Decrypt easily -->
			<LinearLayout
				android:layout_width="match_parent"
				android:layout_height="match_parent"
				android:gravity="center"
				android:orientation="vertical"
				android:paddingStart="32dp"
				android:paddingEnd="32dp">

				<FrameLayout
					android:layout_width="96dp"
					android:layout_height="96dp"
					android:background="@drawable/bg_icon_badge_green">

					<ImageView
						android:layout_width="48dp"
						android:layout_height="48dp"
						android:layout_gravity="center"
						android:src="@drawable/ic_decrypt_card"
						android:contentDescription="Decrypt icon" />
				</FrameLayout>

				<TextView
					android:id="@+id/tv_onboarding_title_3"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:layout_marginTop="32dp"
					android:text="Decrypt easily"
					android:textColor="@color/text_primary"
					android:textSize="24sp"
					android:textStyle="bold"
					android:gravity="center" />

				<TextView
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:layout_marginTop="12dp"
					android:text="The recipient can use Hkode to quickly open, verify, and read protected messages."
					android:textColor="@color/text_secondary"
					android:textSize="14sp"
					android:gravity="center"
					android:lineSpacingExtra="3dp" />
			</LinearLayout>

			<!-- Step 4: Password protection -->
			<LinearLayout
				android:layout_width="match_parent"
				android:layout_height="match_parent"
				android:gravity="center"
				android:orientation="vertical"
				android:paddingStart="32dp"
				android:paddingEnd="32dp">

				<FrameLayout
					android:layout_width="96dp"
					android:layout_height="96dp"
					android:background="@drawable/bg_icon_badge_indigo">

					<ImageView
						android:layout_width="48dp"
						android:layout_height="48dp"
						android:layout_gravity="center"
						android:src="@drawable/ic_custom_card"
						android:contentDescription="Custom icon" />
				</FrameLayout>

				<TextView
					android:id="@+id/tv_onboarding_title_4"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:layout_marginTop="32dp"
					android:text="Password protection"
					android:textColor="@color/text_primary"
					android:textSize="24sp"
					android:textStyle="bold"
					android:gravity="center" />

				<TextView
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:layout_marginTop="12dp"
					android:text="Custom mode allows the sender and recipient to lock messages using a private shared secret password."
					android:textColor="@color/text_secondary"
					android:textSize="14sp"
					android:gravity="center"
					android:lineSpacingExtra="3dp" />
			</LinearLayout>

			<!-- Step 5: Ready to use Hkode? -->
			<LinearLayout
				android:layout_width="match_parent"
				android:layout_height="match_parent"
				android:gravity="center"
				android:orientation="vertical"
				android:paddingStart="32dp"
				android:paddingEnd="32dp">

				<FrameLayout
					android:layout_width="96dp"
					android:layout_height="96dp"
					android:background="@drawable/bg_icon_badge_blue">

					<ImageView
						android:layout_width="48dp"
						android:layout_height="48dp"
						android:layout_gravity="center"
						android:src="@drawable/ic_shield_check"
						app:tint="@color/colorPrimary"
						android:contentDescription="Ready icon" />
				</FrameLayout>

				<TextView
					android:id="@+id/tv_onboarding_title_5"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:layout_marginTop="32dp"
					android:text="Ready to use Hkode?"
					android:textColor="@color/text_primary"
					android:textSize="24sp"
					android:textStyle="bold"
					android:gravity="center" />

				<TextView
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:layout_marginTop="12dp"
					android:text="Start encrypting and decrypting messages securely and privately right away."
					android:textColor="@color/text_secondary"
					android:textSize="14sp"
					android:gravity="center"
					android:lineSpacingExtra="3dp" />
			</LinearLayout>

		</ViewFlipper>
	</FrameLayout>

	<!-- Bottom Controls (Dots + Primary Action Button) -->
	<LinearLayout
		android:id="@+id/footer_onboarding"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:orientation="vertical"
		android:paddingStart="24dp"
		android:paddingEnd="24dp"
		android:paddingBottom="32dp"
		android:paddingTop="16dp">

		<!-- Step Indicators (5 Dots) -->
		<LinearLayout
			android:id="@+id/layout_dots"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_gravity="center_horizontal"
			android:orientation="horizontal"
			android:layout_marginBottom="24dp">

			<View
				android:id="@+id/dot_1"
				android:layout_width="20dp"
				android:layout_height="6dp"
				android:background="@drawable/bg_badge_blue" />

			<View
				android:id="@+id/dot_2"
				android:layout_width="6dp"
				android:layout_height="6dp"
				android:layout_marginStart="6dp"
				android:background="@drawable/bg_segmented_selected" />

			<View
				android:id="@+id/dot_3"
				android:layout_width="6dp"
				android:layout_height="6dp"
				android:layout_marginStart="6dp"
				android:background="@drawable/bg_segmented_selected" />

			<View
				android:id="@+id/dot_4"
				android:layout_width="6dp"
				android:layout_height="6dp"
				android:layout_marginStart="6dp"
				android:background="@drawable/bg_segmented_selected" />

			<View
				android:id="@+id/dot_5"
				android:layout_width="6dp"
				android:layout_height="6dp"
				android:layout_marginStart="6dp"
				android:background="@drawable/bg_segmented_selected" />
		</LinearLayout>

		<!-- Primary Action Button (50dp height, title-case, flat zero elevation) -->
		<com.google.android.material.button.MaterialButton
			android:id="@+id/btn_onboarding_action"
			android:layout_width="match_parent"
			android:layout_height="50dp"
			android:minHeight="50dp"
			android:insetTop="0dp"
			android:insetBottom="0dp"
			app:elevation="0dp"
			android:stateListAnimator="@null"
			android:text="Continue"
			android:textColor="#000000"
			android:textSize="14sp"
			android:textStyle="bold"
			android:textAllCaps="false"
			app:cornerRadius="14dp"
			android:background="@drawable/bg_gradient_button"
			app:backgroundTint="@null" />
	</LinearLayout>

</LinearLayout>

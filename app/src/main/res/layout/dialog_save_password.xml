<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_container"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:id="@+id/tv_dialog_save_pwd_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Save Password"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Save this key to your local vault for quick autofill."
        android:textSize="12sp"
        android:textColor="@color/text_secondary" />

    <!-- Label / Title Input -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Label (e.g. Work Key, Best Friend)"
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary" />

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        app:boxBackgroundMode="none"
        android:background="@drawable/bg_gradient_stroke_input_selector"
        app:hintEnabled="false">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/et_dialog_pwd_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="52dp"
            android:gravity="center_vertical"
            android:includeFontPadding="false"
            android:hint="Enter key label"
            android:inputType="textCapWords"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_muted"
            android:textSize="14sp" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Password Input -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Password / Secret Key"
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary" />

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        app:boxBackgroundMode="none"
        android:background="@drawable/bg_gradient_stroke_input_selector"
        app:hintEnabled="false"
        app:endIconMode="password_toggle"
        app:endIconTint="@color/text_muted">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/et_dialog_pwd_value"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="52dp"
            android:gravity="center_vertical"
            android:includeFontPadding="false"
            android:hint="Enter password"
            android:inputType="textPassword"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_muted"
            android:textSize="14sp" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_dialog_save_pwd_cancel"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:minHeight="48dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            app:elevation="0dp"
            android:stateListAnimator="@null"
            android:text="Cancel"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textAllCaps="false"
            app:cornerRadius="12dp"
            app:backgroundTint="@color/card_background"
            app:strokeWidth="1dp"
            app:strokeColor="@color/card_stroke" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_dialog_save_pwd_confirm"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:minHeight="48dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            app:elevation="0dp"
            android:stateListAnimator="@null"
            android:text="Save Key"
            android:textColor="#000000"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textAllCaps="false"
            app:cornerRadius="12dp"
            android:background="@drawable/bg_gradient_button"
            app:backgroundTint="@null" />
    </LinearLayout>

</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	android:id="@+id/layout_encrypt_root"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:background="@color/app_background"
	android:orientation="vertical">

	<!-- Top Navigation Header -->
	<LinearLayout
		android:id="@+id/header_encrypt"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:paddingStart="20dp"
		android:paddingEnd="20dp"
		android:paddingTop="16dp"
		android:paddingBottom="12dp"
		android:gravity="center_vertical"
		android:orientation="horizontal">

		<FrameLayout
			android:id="@+id/btn_back_encrypt"
			android:layout_width="40dp"
			android:layout_height="40dp"
			android:background="@drawable/bg_back_button"
			android:clickable="true"
			android:focusable="true">

			<ImageView
				android:layout_width="20dp"
				android:layout_height="20dp"
				android:layout_gravity="center"
				android:src="@drawable/ic_arrow_back"
				app:tint="@color/icon_tint_primary"
				android:contentDescription="Back" />
		</FrameLayout>

		<TextView
			android:id="@+id/tv_encrypt_screen_title"
			android:layout_width="0dp"
			android:layout_height="wrap_content"
			android:layout_weight="1"
			android:layout_marginStart="14dp"
			android:text="Encrypt"
			android:textSize="18sp"
			android:textColor="@color/text_primary"
			android:textStyle="bold" />

		<View
			android:layout_width="40dp"
			android:layout_height="40dp" />
	</LinearLayout>

	<!-- Scrollable Content -->
	<androidx.core.widget.NestedScrollView
		android:id="@+id/scroll_encrypt"
		android:layout_width="match_parent"
		android:layout_height="0dp"
		android:layout_weight="1"
		android:fillViewport="true"
		android:overScrollMode="never">

		<LinearLayout
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:orientation="vertical"
			android:paddingStart="20dp"
			android:paddingEnd="20dp"
			android:paddingTop="8dp"
			android:paddingBottom="32dp">

			<!-- Segmented Protection Method Selector -->
			<LinearLayout
				android:id="@+id/segmented_selector"
				android:layout_width="match_parent"
				android:layout_height="44dp"
				android:background="@drawable/bg_segmented_container"
				android:orientation="horizontal">

				<TextView
					android:id="@+id/tab_mode_system"
					android:layout_width="0dp"
					android:layout_height="match_parent"
					android:layout_weight="1"
					android:background="@drawable/bg_segmented_selected"
					android:gravity="center"
					android:text="System"
					android:textColor="@color/colorPrimary"
					android:textSize="13sp"
					android:textStyle="bold" />

				<TextView
					android:id="@+id/tab_mode_password"
					android:layout_width="0dp"
					android:layout_height="match_parent"
					android:layout_weight="1"
					android:gravity="center"
					android:text="Password"
					android:textColor="@color/text_secondary"
					android:textSize="13sp" />
			</LinearLayout>

			<!-- Expandable Password Field with Proper Rounded Container -->
			<LinearLayout
				android:id="@+id/layout_password_field"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="16dp"
				android:visibility="gone"
				android:orientation="vertical">

				<LinearLayout
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:gravity="center_vertical"
					android:orientation="horizontal">

					<TextView
						android:layout_width="0dp"
						android:layout_height="wrap_content"
						android:layout_weight="1"
						android:text="Password"
						android:textSize="13sp"
						android:textStyle="bold"
						android:textColor="@color/text_primary" />

					<!-- Saved Keys Action (Opens Bottom Sheet) -->
					<com.google.android.material.button.MaterialButton
						android:id="@+id/btn_saved_passwords_encrypt"
						style="@style/Widget.MaterialComponents.Button.TextButton"
						android:layout_width="wrap_content"
						android:layout_height="32dp"
						android:minHeight="32dp"
						android:minWidth="0dp"
						android:insetTop="0dp"
						android:insetBottom="0dp"
						app:elevation="0dp"
						android:stateListAnimator="@null"
						android:paddingStart="6dp"
						android:paddingEnd="6dp"
						android:text="Saved Keys"
						android:textSize="11sp"
						android:textStyle="bold"
						android:textColor="@color/colorPrimary"
						app:icon="@drawable/ic_key"
						app:iconTint="@color/colorPrimary"
						app:iconSize="12dp"
						app:iconPadding="3dp" />

					<!-- Save Current Key Action -->
					<com.google.android.material.button.MaterialButton
						android:id="@+id/btn_save_current_password_encrypt"
						style="@style/Widget.MaterialComponents.Button.TextButton"
						android:layout_width="wrap_content"
						android:layout_height="32dp"
						android:minHeight="32dp"
						android:minWidth="0dp"
						android:layout_marginStart="4dp"
						android:insetTop="0dp"
						android:insetBottom="0dp"
						app:elevation="0dp"
						android:stateListAnimator="@null"
						android:paddingStart="6dp"
						android:paddingEnd="6dp"
						android:text="Save Key"
						android:textSize="11sp"
						android:textColor="@color/text_secondary" />
				</LinearLayout>

				<com.google.android.material.textfield.TextInputLayout
					android:id="@+id/til_password"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:layout_marginTop="6dp"
					app:boxBackgroundMode="none"
					android:background="@drawable/bg_gradient_stroke_input_selector"
					app:hintEnabled="false"
					app:startIconDrawable="@drawable/ic_key"
					app:startIconTint="@color/text_muted"
					app:endIconMode="password_toggle"
					app:endIconTint="@color/text_muted">

					<com.google.android.material.textfield.TextInputEditText
						android:id="@+id/et_password"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:minHeight="54dp"
						android:gravity="center_vertical"
						android:includeFontPadding="false"
						android:hint="Enter password"
						android:inputType="textPassword"
						android:paddingStart="14dp"
						android:paddingEnd="14dp"
						android:paddingTop="12dp"
						android:paddingBottom="12dp"
						android:textColor="@color/text_primary"
						android:textColorHint="@color/text_muted"
						android:textSize="14sp" />
				</com.google.android.material.textfield.TextInputLayout>

				<TextView
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:layout_marginTop="4dp"
					android:text="Recipient must enter this exact password to decrypt."
					android:textSize="11sp"
					android:textColor="@color/text_muted" />
			</LinearLayout>

			<!-- Message Composer Card -->
			<LinearLayout
				android:id="@+id/card_message_input"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="16dp"
				android:background="@drawable/bg_input_box"
				android:orientation="vertical"
				android:padding="16dp">

				<!-- Header row with Paste & Clear (Zero vertical clipping) -->
				<LinearLayout
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:gravity="center_vertical"
					android:orientation="horizontal">

					<TextView
						android:layout_width="0dp"
						android:layout_height="wrap_content"
						android:layout_weight="1"
						android:text="Message"
						android:textSize="13sp"
						android:textStyle="bold"
						android:textColor="@color/text_primary" />

					<!-- Paste Action (Flat, No shadow, No clipping) -->
					<com.google.android.material.button.MaterialButton
						android:id="@+id/btn_paste_message"
						style="@style/Widget.MaterialComponents.Button.TextButton"
						android:layout_width="wrap_content"
						android:layout_height="36dp"
						android:minHeight="36dp"
						android:minWidth="0dp"
						android:insetTop="0dp"
						android:insetBottom="0dp"
						app:elevation="0dp"
						android:stateListAnimator="@null"
						android:paddingStart="10dp"
						android:paddingEnd="10dp"
						android:paddingTop="0dp"
						android:paddingBottom="0dp"
						android:gravity="center"
						android:text="Paste"
						android:textSize="12sp"
						android:textColor="@color/colorPrimary"
						app:icon="@drawable/ic_paste"
						app:iconTint="@color/colorPrimary"
						app:iconSize="14dp"
						app:iconGravity="textStart"
						app:iconPadding="4dp" />

					<!-- Clear Action (Flat, No shadow, No clipping) -->
					<com.google.android.material.button.MaterialButton
						android:id="@+id/btn_clear_message"
						style="@style/Widget.MaterialComponents.Button.TextButton"
						android:layout_width="wrap_content"
						android:layout_height="36dp"
						android:minHeight="36dp"
						android:minWidth="0dp"
						android:insetTop="0dp"
						android:insetBottom="0dp"
						app:elevation="0dp"
						android:stateListAnimator="@null"
						android:paddingStart="8dp"
						android:paddingEnd="8dp"
						android:paddingTop="0dp"
						android:paddingBottom="0dp"
						android:gravity="center"
						android:text="Clear"
						android:textSize="12sp"
						android:textColor="@color/text_muted" />
				</LinearLayout>

				<EditText
					android:id="@+id/et_message"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:layout_marginTop="10dp"
					android:minLines="5"
					android:maxLines="10"
					android:gravity="top|start"
					android:background="@null"
					android:hint="Type or paste your message..."
					android:textColor="@color/text_primary"
					android:textColorHint="@color/text_muted"
					android:textSize="14sp"
					android:lineSpacingExtra="3dp" />

				<TextView
					android:id="@+id/tv_char_count"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:layout_gravity="end"
					android:layout_marginTop="6dp"
					android:text="0 characters"
					android:textSize="11sp"
					android:textColor="@color/text_muted" />
			</LinearLayout>

			<!-- Primary Action Button (50dp height, title-case, flat zero elevation) -->
			<FrameLayout
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="20dp">

				<com.google.android.material.button.MaterialButton
					android:id="@+id/btn_encrypt_action"
					android:layout_width="match_parent"
					android:layout_height="50dp"
					android:minHeight="50dp"
					android:insetTop="0dp"
					android:insetBottom="0dp"
					app:elevation="0dp"
					android:stateListAnimator="@null"
					android:text="Encrypt Message"
					android:textColor="#000000"
					android:textSize="14sp"
					android:textStyle="bold"
					android:textAllCaps="false"
					app:cornerRadius="14dp"
					android:background="@drawable/bg_gradient_button"
					app:backgroundTint="@null" />

				<ProgressBar
					android:id="@+id/progress_encrypt"
					android:layout_width="26dp"
					android:layout_height="26dp"
					android:layout_gravity="center"
					android:visibility="gone"
					android:indeterminateTint="#000000" />
			</FrameLayout>

			<!-- Error Card -->
			<com.google.android.material.card.MaterialCardView
				android:id="@+id/card_encrypt_error"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="16dp"
				android:visibility="gone"
				app:cardCornerRadius="14dp"
				app:cardElevation="0dp"
				app:strokeWidth="1dp"
				app:strokeColor="@color/color_error_stroke"
				app:cardBackgroundColor="@color/color_error_bg">

				<TextView
					android:id="@+id/tv_encrypt_error"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:padding="14dp"
					android:textColor="@color/color_error"
					android:textSize="13sp"
					android:lineSpacingExtra="2dp" />
			</com.google.android.material.card.MaterialCardView>

			<!-- Result Card with Light/Theme-aware Surface and Flat Action Row -->
			<com.google.android.material.card.MaterialCardView
				android:id="@+id/card_encrypt_result"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="20dp"
				android:visibility="gone"
				app:cardCornerRadius="16dp"
				app:cardElevation="0dp"
				app:strokeWidth="1dp"
				app:strokeColor="@color/color_success_stroke"
				app:cardBackgroundColor="@color/card_background">

				<LinearLayout
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:orientation="vertical"
					android:padding="16dp">

					<LinearLayout
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:gravity="center_vertical"
						android:orientation="horizontal">

						<TextView
							android:layout_width="0dp"
							android:layout_height="wrap_content"
							android:layout_weight="1"
							android:text="Encrypted message"
							android:textSize="13sp"
							android:textStyle="bold"
							android:textColor="@color/text_primary" />

						<TextView
							android:id="@+id/tv_encrypt_badge"
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:background="@drawable/bg_badge_blue"
							android:text="System"
							android:textColor="@color/badge_system_text"
							android:textSize="11sp"
							android:textStyle="bold" />
					</LinearLayout>

					<!-- Monospace Result Container (Clean Light Surface in Light Mode) -->
					<LinearLayout
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:layout_marginTop="10dp"
						android:background="@drawable/bg_ciphertext_container"
						android:orientation="vertical"
						android:padding="14dp">

						<TextView
							android:id="@+id/tv_ciphertext_result"
							android:layout_width="match_parent"
							android:layout_height="wrap_content"
							android:fontFamily="monospace"
							android:textColor="@color/ciphertext_text"
							android:textSize="13sp"
							android:textIsSelectable="true"
							android:lineSpacingExtra="3dp" />
					</LinearLayout>

					<!-- Flat Action Row: Copy, Share, New (44dp, equal 1:1:1 weights) -->
					<LinearLayout
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:layout_marginTop="14dp"
						android:orientation="horizontal">

						<com.google.android.material.button.MaterialButton
							android:id="@+id/btn_copy_ciphertext"
							android:layout_width="0dp"
							android:layout_height="44dp"
							android:minHeight="44dp"
							android:layout_weight="1"
							android:layout_marginEnd="5dp"
							android:insetTop="0dp"
							android:insetBottom="0dp"
							app:elevation="0dp"
							android:stateListAnimator="@null"
							android:text="Copy"
							android:textColor="#000000"
							android:textSize="12sp"
							android:singleLine="true"
							android:maxLines="1"
							android:paddingStart="4dp"
							android:paddingEnd="4dp"
							android:textAllCaps="false"
							app:cornerRadius="12dp"
							android:background="@drawable/bg_gradient_button"
							app:backgroundTint="@null"
							app:icon="@drawable/ic_copy"
							app:iconTint="#000000"
							app:iconSize="14dp"
							app:iconPadding="3dp" />

						<com.google.android.material.button.MaterialButton
							android:id="@+id/btn_share_ciphertext"
							android:layout_width="0dp"
							android:layout_height="44dp"
							android:minHeight="44dp"
							android:layout_weight="1"
							android:layout_marginStart="5dp"
							android:layout_marginEnd="5dp"
							android:insetTop="0dp"
							android:insetBottom="0dp"
							app:elevation="0dp"
							android:stateListAnimator="@null"
							android:text="Share"
							android:textColor="@color/text_primary"
							android:textSize="12sp"
							android:singleLine="true"
							android:maxLines="1"
							android:paddingStart="4dp"
							android:paddingEnd="4dp"
							android:textAllCaps="false"
							app:cornerRadius="12dp"
							app:backgroundTint="@color/button_action_bg"
							app:strokeWidth="1dp"
							app:strokeColor="@color/button_action_stroke"
							app:icon="@drawable/ic_share"
							app:iconTint="@color/text_primary"
							app:iconSize="14dp"
							app:iconPadding="3dp" />

						<com.google.android.material.button.MaterialButton
							android:id="@+id/btn_new_encrypt"
							android:layout_width="0dp"
							android:layout_height="44dp"
							android:minHeight="44dp"
							android:layout_weight="1"
							android:layout_marginStart="5dp"
							android:insetTop="0dp"
							android:insetBottom="0dp"
							app:elevation="0dp"
							android:stateListAnimator="@null"
							android:text="New"
							android:textColor="@color/text_secondary"
							android:textSize="12sp"
							android:singleLine="true"
							android:maxLines="1"
							android:paddingStart="4dp"
							android:paddingEnd="4dp"
							android:textAllCaps="false"
							app:cornerRadius="12dp"
							app:backgroundTint="@color/card_background"
							app:strokeWidth="1dp"
							app:strokeColor="@color/card_stroke" />
					</LinearLayout>
				</LinearLayout>
			</com.google.android.material.card.MaterialCardView>

		</LinearLayout>
	</androidx.core.widget.NestedScrollView>

</LinearLayout>

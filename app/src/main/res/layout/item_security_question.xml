<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layout_item_question_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="56dp"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_question_item"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp">

    <!-- Icon Badge -->
    <FrameLayout
        android:id="@+id/layout_question_icon_badge"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:background="@drawable/bg_icon_badge_blue">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_help_circle"
            app:tint="@color/colorPrimary"
            android:contentDescription="Question" />
    </FrameLayout>

    <!-- Question Text & Status -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="10dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_question_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:textStyle="bold"
            android:lineSpacingExtra="2dp" />

        <TextView
            android:id="@+id/tv_question_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Currently in use"
            android:textColor="@color/color_warning"
            android:textSize="11sp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Checkmark Indicator -->
    <FrameLayout
        android:id="@+id/layout_question_check"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_check"
            app:tint="@color/colorPrimary"
            android:contentDescription="Selected" />
    </FrameLayout>
</LinearLayout>

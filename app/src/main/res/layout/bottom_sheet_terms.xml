<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:background="@drawable/bg_bottom_sheet"
	android:orientation="vertical">

	<!-- Top Drag Handle -->
	<View
		android:layout_width="44dp"
		android:layout_height="5dp"
		android:layout_gravity="center_horizontal"
		android:layout_marginTop="12dp"
		android:background="@drawable/bg_drag_handle" />

	<!-- Header Bar -->
	<LinearLayout
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:paddingStart="24dp"
		android:paddingEnd="20dp"
		android:paddingTop="16dp"
		android:paddingBottom="12dp"
		android:gravity="center_vertical"
		android:orientation="horizontal">

		<TextView
			android:layout_width="0dp"
			android:layout_height="wrap_content"
			android:layout_weight="1"
			android:text="Terms &amp; Conditions"
			android:textSize="20sp"
			android:textColor="@color/text_primary"
			android:textStyle="bold" />

		<FrameLayout
			android:id="@+id/btn_terms_close"
			android:layout_width="36dp"
			android:layout_height="36dp"
			android:background="@drawable/bg_back_button"
			android:clickable="true"
			android:focusable="true">

			<ImageView
				android:layout_width="18dp"
				android:layout_height="18dp"
				android:layout_gravity="center"
				android:src="@drawable/ic_close"
				app:tint="@color/icon_tint_primary"
				android:contentDescription="Close" />
		</FrameLayout>
	</LinearLayout>

	<View
		android:layout_width="match_parent"
		android:layout_height="1dp"
		android:background="@color/card_stroke" />

	<!-- Continuous Plain Text Content -->
	<androidx.core.widget.NestedScrollView
		android:layout_width="match_parent"
		android:layout_height="0dp"
		android:layout_weight="1"
		android:fillViewport="true"
		android:overScrollMode="never">

		<LinearLayout
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:orientation="vertical"
			android:paddingStart="24dp"
			android:paddingEnd="24dp"
			android:paddingTop="18dp"
			android:paddingBottom="48dp">

			<TextView
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:text="Effective Date: September 2026 • Version 1.0"
				android:textSize="12sp"
				android:textStyle="bold"
				android:textColor="@color/text_muted" />

			<TextView
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="16dp"
				android:text="1. Acceptance of Terms"
				android:textSize="15sp"
				android:textStyle="bold"
				android:textColor="@color/text_primary" />

			<TextView
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="6dp"
				android:text="By accessing, installing, or executing the Hkode application, you agree to be bound by these Terms and Conditions. Hkode is a local cryptography utility provided to enable secure client-side text encryption, authenticated AES-256-GCM data obfuscation, and zero-knowledge local key custody."
				android:textSize="13sp"
				android:textColor="@color/text_secondary"
				android:lineSpacingExtra="5dp" />

			<TextView
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="20dp"
				android:text="2. Sole Custody of Cryptographic Keys"
				android:textSize="15sp"
				android:textStyle="bold"
				android:textColor="@color/text_primary" />

			<TextView
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="6dp"
				android:text="Hkode operates under an uncompromising Zero-Knowledge paradigm. All encryption algorithms run entirely on your device hardware without connecting to remote servers for key exchange or recovery escrow. You explicitly acknowledge that if you lose or forget the passphrase used to encrypt a message, it is mathematically impossible for anyone — including the developers of Hkode — to decrypt or recover your plaintext."
				android:textSize="13sp"
				android:textColor="@color/text_secondary"
				android:lineSpacingExtra="5dp" />

			<TextView
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="20dp"
				android:text="3. Permissible &amp; Lawful Use"
				android:textSize="15sp"
				android:textStyle="bold"
				android:textColor="@color/text_primary" />

			<TextView
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="6dp"
				android:text="You agree to utilize Hkode exclusively for lawful purposes in accordance with all applicable international, national, and local laws and regulations. You shall not use Hkode to facilitate extortion, transmit unlawful or malicious payloads, or infringe upon third-party rights."
				android:textSize="13sp"
				android:textColor="@color/text_secondary"
				android:lineSpacingExtra="5dp" />

			<TextView
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="20dp"
				android:text="4. Disclaimer of Warranties"
				android:textSize="15sp"
				android:textStyle="bold"
				android:textColor="@color/text_primary" />

			<TextView
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="6dp"
				android:text="Hkode is provided on an 'AS-IS' and 'AS-AVAILABLE' basis without warranty of any kind, whether express, statutory, or implied. While cryptographic operations strictly follow NIST standards for AES-GCM and PBKDF2, the developers do not warrant uninterrupted operation or error-free character transmission through third-party messaging services."
				android:textSize="13sp"
				android:textColor="@color/text_secondary"
				android:lineSpacingExtra="5dp" />

			<TextView
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="20dp"
				android:text="5. Local Storage &amp; Data Control"
				android:textSize="15sp"
				android:textStyle="bold"
				android:textColor="@color/text_primary" />

			<TextView
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="6dp"
				android:text="Hkode stores saved keys, settings, and encryption history solely in local sandbox storage on your device. No analytics, tracking beacons, or telemetry data are gathered. You can purge all application records and restore default configurations at any time via Settings."
				android:textSize="13sp"
				android:textColor="@color/text_secondary"
				android:lineSpacingExtra="5dp" />

		</LinearLayout>
	</androidx.core.widget.NestedScrollView>

</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layout_setup_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background"
    android:orientation="vertical">

    <!-- Top Header Bar -->
    <LinearLayout
        android:id="@+id/header_setup_dialog"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:id="@+id/btn_setup_close"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_back_button"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_close"
                app:tint="@color/icon_tint_primary"
                android:contentDescription="Close" />
        </FrameLayout>

        <TextView
            android:id="@+id/tv_setup_screen_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="14dp"
            android:text="Passcode Protection"
            android:textSize="18sp"
            android:textColor="@color/text_primary"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btn_setup_cancel_step"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:text="Cancel"
            android:textColor="@color/colorPrimary"
            android:textSize="14sp"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless" />
    </LinearLayout>

    <!-- Main Content Area: Centered PIN slots -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="28dp"
        android:paddingEnd="28dp">

        <FrameLayout
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/bg_icon_badge_blue">

            <ImageView
                android:id="@+id/iv_setup_badge_icon"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_shield_check"
                app:tint="@color/colorPrimary"
                android:contentDescription="Shield" />
        </FrameLayout>

        <TextView
            android:id="@+id/tv_setup_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Create App Passcode"
            android:textColor="@color/text_primary"
            android:textSize="22sp"
            android:textStyle="bold"
            android:gravity="center" />

        <TextView
            android:id="@+id/tv_setup_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Enter a 4-digit passcode to protect your data"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:gravity="center" />

        <TextView
            android:id="@+id/tv_setup_error"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Passcodes didn't match. Try again."
            android:textColor="@color/color_error"
            android:textSize="13sp"
            android:textStyle="bold"
            android:visibility="invisible" />

        <!-- 4 Visual PIN Slots with rounded corners -->
        <LinearLayout
            android:id="@+id/layout_setup_pin_slots"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="horizontal"
            android:gravity="center">

            <!-- Slot 1 -->
            <FrameLayout
                android:id="@+id/slot_setup_1"
                android:layout_width="54dp"
                android:layout_height="58dp"
                android:layout_margin="7dp"
                android:background="@drawable/bg_pin_box">

                <View
                    android:id="@+id/dot_setup_1"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_pin_dot"
                    android:visibility="gone" />
            </FrameLayout>

            <!-- Slot 2 -->
            <FrameLayout
                android:id="@+id/slot_setup_2"
                android:layout_width="54dp"
                android:layout_height="58dp"
                android:layout_margin="7dp"
                android:background="@drawable/bg_pin_box">

                <View
                    android:id="@+id/dot_setup_2"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_pin_dot"
                    android:visibility="gone" />
            </FrameLayout>

            <!-- Slot 3 -->
            <FrameLayout
                android:id="@+id/slot_setup_3"
                android:layout_width="54dp"
                android:layout_height="58dp"
                android:layout_margin="7dp"
                android:background="@drawable/bg_pin_box">

                <View
                    android:id="@+id/dot_setup_3"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_pin_dot"
                    android:visibility="gone" />
            </FrameLayout>

            <!-- Slot 4 -->
            <FrameLayout
                android:id="@+id/slot_setup_4"
                android:layout_width="54dp"
                android:layout_height="58dp"
                android:layout_margin="7dp"
                android:background="@drawable/bg_pin_box">

                <View
                    android:id="@+id/dot_setup_4"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_pin_dot"
                    android:visibility="gone" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Keypad Container (3x4 Numeric Keypad) -->
    <TableLayout
        android:id="@+id/keypad_setup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="28dp"
        android:stretchColumns="*">

        <!-- Row 1: 1, 2, 3 -->
        <TableRow
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp">

            <TextView
                android:id="@+id/btn_setup_key_1"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:layout_margin="4dp"
                android:background="@drawable/bg_keypad_button"
                android:gravity="center"
                android:text="1"
                android:textColor="@color/text_primary"
                android:textSize="22sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/btn_setup_key_2"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:layout_margin="4dp"
                android:background="@drawable/bg_keypad_button"
                android:gravity="center"
                android:text="2"
                android:textColor="@color/text_primary"
                android:textSize="22sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/btn_setup_key_3"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:layout_margin="4dp"
                android:background="@drawable/bg_keypad_button"
                android:gravity="center"
                android:text="3"
                android:textColor="@color/text_primary"
                android:textSize="22sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true" />
        </TableRow>

        <!-- Row 2: 4, 5, 6 -->
        <TableRow
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp">

            <TextView
                android:id="@+id/btn_setup_key_4"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:layout_margin="4dp"
                android:background="@drawable/bg_keypad_button"
                android:gravity="center"
                android:text="4"
                android:textColor="@color/text_primary"
                android:textSize="22sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/btn_setup_key_5"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:layout_margin="4dp"
                android:background="@drawable/bg_keypad_button"
                android:gravity="center"
                android:text="5"
                android:textColor="@color/text_primary"
                android:textSize="22sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/btn_setup_key_6"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:layout_margin="4dp"
                android:background="@drawable/bg_keypad_button"
                android:gravity="center"
                android:text="6"
                android:textColor="@color/text_primary"
                android:textSize="22sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true" />
        </TableRow>

        <!-- Row 3: 7, 8, 9 -->
        <TableRow
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp">

            <TextView
                android:id="@+id/btn_setup_key_7"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:layout_margin="4dp"
                android:background="@drawable/bg_keypad_button"
                android:gravity="center"
                android:text="7"
                android:textColor="@color/text_primary"
                android:textSize="22sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/btn_setup_key_8"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:layout_margin="4dp"
                android:background="@drawable/bg_keypad_button"
                android:gravity="center"
                android:text="8"
                android:textColor="@color/text_primary"
                android:textSize="22sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/btn_setup_key_9"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:layout_margin="4dp"
                android:background="@drawable/bg_keypad_button"
                android:gravity="center"
                android:text="9"
                android:textColor="@color/text_primary"
                android:textSize="22sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true" />
        </TableRow>

        <!-- Row 4: Empty/Cancel, 0, Backspace -->
        <TableRow
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <View
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:layout_margin="4dp" />

            <TextView
                android:id="@+id/btn_setup_key_0"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:layout_margin="4dp"
                android:background="@drawable/bg_keypad_button"
                android:gravity="center"
                android:text="0"
                android:textColor="@color/text_primary"
                android:textSize="22sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true" />

            <FrameLayout
                android:id="@+id/btn_setup_key_delete"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:layout_margin="4dp"
                android:background="@drawable/bg_keypad_button"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_delete"
                    app:tint="@color/text_primary"
                    android:contentDescription="Delete digit" />
            </FrameLayout>
        </TableRow>
    </TableLayout>

</LinearLayout>

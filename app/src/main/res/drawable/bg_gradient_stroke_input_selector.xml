<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Focused State: 2dp Button Gradient Stroke -->
    <item android:state_focused="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="16dp" />
                    <gradient
                        android:startColor="@color/gradient_green_start"
                        android:centerColor="@color/gradient_green_center"
                        android:endColor="@color/gradient_green_end"
                        android:angle="0" />
                </shape>
            </item>
            <item
                android:top="2dp"
                android:bottom="2dp"
                android:left="2dp"
                android:right="2dp">
                <shape android:shape="rectangle">
                    <corners android:radius="14dp" />
                    <solid android:color="@color/card_background" />
                </shape>
            </item>
        </layer-list>
    </item>

    <!-- Default State: 1.5dp Button Gradient Stroke -->
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="16dp" />
                    <gradient
                        android:startColor="@color/gradient_green_start"
                        android:centerColor="@color/gradient_green_center"
                        android:endColor="@color/gradient_green_end"
                        android:angle="0" />
                </shape>
            </item>
            <item
                android:top="1.5dp"
                android:bottom="1.5dp"
                android:left="1.5dp"
                android:right="1.5dp">
                <shape android:shape="rectangle">
                    <corners android:radius="14.5dp" />
                    <solid android:color="@color/card_background" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>

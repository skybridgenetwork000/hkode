<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Checked State: Black Pill Thumb for Maximum Contrast on Gradient -->
    <item android:state_checked="true">
        <layer-list>
            <item
                android:top="4dp"
                android:bottom="4dp"
                android:left="4dp"
                android:right="4dp">
                <shape android:shape="oval">
                    <solid android:color="#000000" />
                    <size android:width="24dp" android:height="24dp" />
                </shape>
            </item>
        </layer-list>
    </item>

    <!-- Unchecked State: Muted Gray Oval Thumb -->
    <item>
        <layer-list>
            <item
                android:top="8dp"
                android:bottom="8dp"
                android:left="8dp"
                android:right="8dp">
                <shape android:shape="oval">
                    <solid android:color="#8E95A5" />
                    <size android:width="16dp" android:height="16dp" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
